# ─────────────────────────────────────────────────────────────────────────────
# StudyDNA Frontend — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# DEV:  Copy to .env.local
# PROD: Add in Vercel → Project Settings → Environment Variables
#
# ⚠  NEVER commit .env.local to git.
# ─────────────────────────────────────────────────────────────────────────────

# URL of the deployed backend (studydna-backend).
# Dev: backend runs on port 4000 by default.
# Prod: set this to your deployed backend URL, e.g. https://studydna-backend.vercel.app
NEXT_PUBLIC_API_URL="http://localhost:4000"
